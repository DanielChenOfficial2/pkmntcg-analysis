{
  "name": "pkmntcg-analysis",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare:capacitor": "node scripts/prepare-capacitor.js",
    "build": "node scripts/prepare-capacitor.js && tailwindcss -c ./tailwind.config.js -i ./tailwind.input.css -o ./website/tailwind.css --minify",
    "cap:add:android": "npm run build && cap add android",
    "cap:add:ios": "npm run build && cap add ios",
    "cap:sync": "npm run build && cap sync",
    "cap:sync:android": "npm run build && cap sync android",
    "cap:sync:ios": "npm run build && cap sync ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "tailwindcss": "3.4.17"
  }
}
